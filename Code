<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>White Dragon — настоящий чай от истоков</title>
<!--
  Анимация появления при скролле:
  элементам с классом .reveal в CSS задаются opacity:0 и сдвиг translateY(30px).
  Intersection Observer в скрипте следит за ними и, когда элемент попадает в
  область видимости, добавляет класс .visible — transition плавно возвращает
  прозрачность и позицию. После появления наблюдение за элементом прекращается.
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{
  --green:#2f4a3a; --green-d:#223629; --green-l:#4f7a5e;
  --beige:#f6f1e7; --beige-d:#e9dfcc; --brown:#7a5638; --text:#2b2a26; --muted:#6b675d;
  --radius:18px; --shadow:0 10px 30px rgba(47,74,58,.10);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--text);background:#fffdf9;line-height:1.6;font-size:16px}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.container{width:min(1140px,100% - 40px);margin-inline:auto}
section{padding:72px 0}
h1,h2,h3{line-height:1.2;color:var(--green-d)}
h2{font-size:1.9rem;margin-bottom:12px}
.lead{color:var(--muted);max-width:560px;margin-bottom:40px}
.eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brown);font-weight:600;margin-bottom:10px}

/* Кнопки */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 28px;border:0;border-radius:999px;background:var(--green);color:#fff;font:600 1rem 'Inter',sans-serif;cursor:pointer;transition:background .3s,box-shadow .3s}
.btn:hover{background:var(--brown);box-shadow:0 8px 20px rgba(122,86,56,.25)}
.btn-light{background:var(--beige);color:var(--green-d)}
.btn-light:hover{background:#fff;color:var(--brown)}

/* Шапка */
header{position:fixed;inset:0 0 auto 0;z-index:100;background:rgba(255,253,249,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--beige-d)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:1.15rem;color:var(--green-d)}
.logo i{color:var(--brown)}
.menu{position:absolute;top:64px;left:0;right:0;background:#fffdf9;display:flex;flex-direction:column;gap:8px;padding:12px 20px 20px;border-bottom:1px solid var(--beige-d);transform:translateY(-12px);opacity:0;visibility:hidden;transition:.3s}
.menu.open{transform:none;opacity:1;visibility:visible}
.menu a{display:flex;align-items:center;justify-content:center;text-align:center;padding:12px 18px;font-weight:600;font-size:1rem;color:var(--green-d);background:var(--beige);border:1px solid var(--beige-d);border-radius:999px;transition:background .3s,color .3s,border-color .3s}
.menu a:hover{background:var(--green);color:#fff;border-color:var(--green)}
.menu a:focus-visible{outline:2px solid var(--brown);outline-offset:2px}
.actions{display:flex;align-items:center;gap:6px}
.cart{position:relative;width:48px;height:48px;display:grid;place-items:center;font-size:1.2rem;color:var(--green-d);background:none;border:0;cursor:pointer}
.cart-count{position:absolute;top:4px;right:2px;min-width:20px;height:20px;padding:0 5px;border-radius:10px;background:var(--brown);color:#fff;font-size:.72rem;font-weight:700;display:grid;place-items:center;transition:transform .3s}
.cart-count.bump{transform:scale(1.4)}
.burger{width:48px;height:48px;background:none;border:0;cursor:pointer;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px}
.burger span{width:24px;height:2px;background:var(--green-d);border-radius:2px;transition:transform .3s,opacity .3s}
.burger.active span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.burger.active span:nth-child(2){opacity:0}
.burger.active span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

/* Hero */
.hero{min-height:100svh;display:flex;align-items:center;padding:110px 0 72px;color:#fff;
  background:linear-gradient(rgba(34,54,41,.68),rgba(34,54,41,.55)),url('https://images.unsplash.com/photo-1564890369478-c89ca6d9cde9?auto=format&fit=crop&w=1600&q=70') center/cover,var(--green)}
.hero h1{color:#fff;font-size:2.3rem;margin-bottom:16px;max-width:640px}
.hero p{font-size:1.1rem;max-width:520px;margin-bottom:32px;color:#efe9da}

/* Каталог */
.grid{display:grid;gap:22px;grid-template-columns:1fr}
.card{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--beige-d);display:flex;flex-direction:column;transition:transform .35s,box-shadow .35s}
.card:hover{transform:scale(1.03);box-shadow:0 16px 40px rgba(47,74,58,.18)}
.card img{aspect-ratio:4/3;object-fit:cover;width:100%;background:var(--beige-d)}
.card-body{padding:20px;display:flex;flex-direction:column;gap:10px;flex:1}
.tag{align-self:flex-start;font-size:.75rem;font-weight:600;padding:4px 12px;border-radius:999px;background:var(--beige);color:var(--brown)}
.card h3{font-size:1.2rem}
.card p{color:var(--muted);font-size:.95rem;flex:1}
.price-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px}
.price{font-weight:700;font-size:1.1rem;color:var(--green-d);white-space:nowrap}
.per{font-size:.82rem;font-weight:500;color:var(--muted);white-space:nowrap}
.add{min-height:48px;padding:0 20px;font-size:.95rem}
.add.done{background:var(--green-l)}
.add.done i{color:#b6f0c4}

/* О видах чая */
.about{background:var(--beige)}
.type{background:#fffdf9;border-radius:var(--radius);padding:26px;border:1px solid var(--beige-d);transition:transform .35s,box-shadow .35s}
.type:hover{transform:scale(1.02);box-shadow:var(--shadow)}
.type-head{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.type-ico{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:1.3rem;color:#fff;background:var(--green)}
.type ul{list-style:none;display:grid;gap:10px;font-size:.93rem}
.type li{display:flex;gap:10px}
.type li i{color:var(--brown);width:18px;margin-top:4px;text-align:center}
.type li b{color:var(--green-d)}

/* CTA */
.cta{position:relative;overflow:hidden;text-align:center;color:#fff;padding:110px 0;background:var(--green-d)}
.cta-bg{position:absolute;inset:-20% 0;background:linear-gradient(rgba(34,54,41,.82),rgba(34,54,41,.82)),url('https://images.unsplash.com/photo-1597318181409-cf64d0b5d8a2?auto=format&fit=crop&w=1600&q=60') center/cover;will-change:transform}
.cta .container{position:relative}
.cta h2{color:#fff;font-size:2rem;margin-bottom:28px}

/* Footer */
footer{background:#1c2b21;color:#cfc8b6;padding:48px 0 28px}
.foot{display:grid;gap:28px;text-align:center}
.foot nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px}
.foot nav a:hover{color:#fff}
.social,.pay{display:flex;justify-content:center;gap:14px;font-size:1.4rem}
.social a{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.08);transition:background .3s,transform .3s}
.social a:hover{background:var(--brown);transform:translateY(-3px)}
.pay{font-size:1.8rem;color:#9a9482}
.copy{margin-top:28px;text-align:center;font-size:.85rem;color:#8d8777}

/* Анимация появления */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease}
.reveal.visible{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}

/* Планшет и десктоп */
@media (min-width:768px){
  .burger{display:none}
  .nav{display:grid;grid-template-columns:1fr auto 1fr;height:72px}
  .logo{justify-self:start}
  .actions{justify-self:end}
  .menu{position:static;flex-direction:row;gap:10px;padding:0;border:0;background:none;opacity:1;visibility:visible;transform:none}
  .menu a{padding:8px 16px;font-size:.95rem}
  .hero h1{font-size:3.6rem}
  h2{font-size:2.4rem}
  .grid{grid-template-columns:repeat(2,1fr)}
  .foot{grid-template-columns:1fr auto 1fr;align-items:center;text-align:left}
  .foot nav{justify-content:center}
  .social{justify-content:flex-start}
  .pay{justify-content:flex-end}
}
@media (min-width:1024px){
  .grid{grid-template-columns:repeat(3,1fr)}
  section{padding:104px 0}
}
</style>
</head>
<body>

<header>
  <div class="container nav">
    <a href="#top" class="logo"><i class="fa-solid fa-dragon"></i> White Dragon</a>
    <nav class="menu" id="menu" aria-label="Главное меню">
      <a href="#catalog">Каталог</a>
      <a href="#about">О видах чая</a>
      <a href="#order">Заказ</a>
      <a href="#contacts">Контакты</a>
    </nav>
    <div class="actions">
      <button class="cart" aria-label="Корзина"><i class="fa-solid fa-basket-shopping"></i><span class="cart-count" id="cartCount">0</span></button>
      <button class="burger" id="burger" aria-label="Открыть меню" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="container reveal">
      <span class="eyebrow" style="color:#d9c3a0">White Dragon Tea</span>
      <h1>Настоящий чай от истоков</h1>
      <p>Отборные листья с лучших плантаций Китая, Японии и Индии — прямо к вашей чашке. Без компромиссов, только вкус.</p>
      <a href="#catalog" class="btn">Выбрать чай <i class="fa-solid fa-arrow-down"></i></a>
    </div>
  </section>

  <section id="catalog">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Каталог</span>
        <h2>Наш чай</h2>
        <p class="lead">Шесть любимых сортов — свежий урожай и бережная упаковка. Цены указаны за 100 грамм.</p>
      </div>
      <div class="grid" id="products"></div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Узнайте больше</span>
        <h2>О видах чая</h2>
        <p class="lead">Короткий путеводитель: откуда чай родом, чем пахнет и как его правильно заварить.</p>
      </div>
      <div class="grid" id="types"></div>
    </div>
  </section>

  <section class="cta" id="order">
    <div class="cta-bg" id="parallax"></div>
    <div class="container reveal">
      <h2>Готовы открыть мир настоящего чая?</h2>
      <a href="#catalog" class="btn btn-light"><i class="fa-solid fa-bag-shopping"></i> Оформить заказ</a>
    </div>
  </section>
</main>

<footer id="contacts">
  <div class="container">
    <div class="foot">
      <nav aria-label="Меню в подвале">
        <a href="#catalog">Каталог</a><a href="#about">О чае</a><a href="#order">Заказ</a>
      </nav>
      <div class="social">
        <a href="#" aria-label="Telegram"><i class="fa-brands fa-telegram"></i></a>
        <a href="#" aria-label="VK"><i class="fa-brands fa-vk"></i></a>
        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
      </div>
      <div class="pay" title="Способы оплаты">
        <i class="fa-brands fa-cc-visa"></i><i class="fa-brands fa-cc-mastercard"></i><i class="fa-solid fa-money-bill-wave"></i>
      </div>
    </div>
    <p class="copy">© 2026 White Dragon. Оплата картой онлайн или наличными при получении.</p>
  </div>
</footer>

<script>
const products=[
 {n:'Лунцзин',t:'Зелёный',d:'Мягкий, ореховый, с лёгкой сладостью каштана.',p:'890 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1627435601361-ec25f5b1d0e5?auto=format&fit=crop&w=600&q=70'},
 {n:'Да Хун Пао',t:'Улун',d:'Тёплый, минеральный, с нотами мёда и печёных фруктов.',p:'1 450 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=600&q=70'},
 {n:'Шу Пуэр',t:'Пуэр',d:'Глубокий, землистый, с оттенками какао и сухофруктов.',p:'1 100 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1594631252845-29fc4cc8cde9?auto=format&fit=crop&w=600&q=70'},
 {n:'Бай Му Дань',t:'Белый',d:'Нежный, цветочный, с послевкусием спелой груши.',p:'1 250 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1563911892437-1feda0179e1b?auto=format&fit=crop&w=600&q=70'},
 {n:'Цимэнь Хун Ча',t:'Чёрный',d:'Насыщенный, с лёгкой дымкой и нотами тёмного шоколада.',p:'950 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1597481499750-3e6b22637e12?auto=format&fit=crop&w=600&q=70'},
 {n:'Горный луг',t:'Травяной',d:'Ромашка, мята и лимонная мелисса — для спокойного вечера.',p:'620 ₽',u:'100 г',i:'https://images.unsplash.com/photo-1576092768241-dec231879fc3?auto=format&fit=crop&w=600&q=70'}
];
const types=[
 {n:'Зелёный',ic:'fa-leaf',o:'Китай, Япония — родина классической чайной традиции.',v:'Травяной, свежий, с цветочными и ореховыми нотами.',e:'Тонизирует, даёт ясность и мягкую бодрость.',c:'75–80 °C'},
 {n:'Чёрный',ic:'fa-mug-hot',o:'Китай и Индия (Ассам, Дарджилинг).',v:'Насыщенный, солодовый, с дымными и шоколадными нотами.',e:'Бодрит, согревает, повышает концентрацию.',c:'95–100 °C'},
 {n:'Улун',ic:'fa-spa',o:'Фуцзянь и Тайвань, полуферментированный чай.',v:'От цветочно-сливочного до жареного и медового.',e:'Поддерживает пищеварение, мягкий тонус.',c:'85–95 °C'},
 {n:'Белый',ic:'fa-snowflake',o:'Провинция Фуцзянь, минимальная обработка листа.',v:'Нежный, цветочный, с лёгкой фруктовой сладостью.',e:'Мягкий антиоксидантный и освежающий эффект.',c:'75–85 °C'},
 {n:'Пуэр',ic:'fa-mountain',o:'Юньнань, выдержанный постферментированный чай.',v:'Землистый, древесный, с нотами какао и сухофруктов.',e:'Помогает пищеварению после плотной еды.',c:'95–100 °C'},
 {n:'Травяной',ic:'fa-seedling',o:'Травы, цветы и ягоды со всего мира.',v:'Цитрусовые, мятные и цветочные ноты.',e:'Расслабляет, успокаивает, подходит на вечер.',c:'90–95 °C'}
];

const el=s=>document.querySelector(s);
el('#products').innerHTML=products.map(x=>`
 <article class="card reveal">
  <img src="${x.i}" alt="${x.n}" loading="lazy">
  <div class="card-body">
   <span class="tag">${x.t}</span>
   <h3>${x.n}</h3>
   <p>${x.d}</p>
   <div class="price-row"><span class="price">${x.p} <span class="per">/ ${x.u}</span></span>
   <button class="btn add"><i class="fa-solid fa-cart-plus"></i><span>В корзину</span></button></div>
  </div>
 </article>`).join('');
el('#types').innerHTML=types.map(x=>`
 <article class="type reveal">
  <div class="type-head"><div class="type-ico"><i class="fa-solid ${x.ic}"></i></div><h3>${x.n} чай</h3></div>
  <ul>
   <li><i class="fa-solid fa-globe"></i><span><b>Происхождение:</b> ${x.o}</span></li>
   <li><i class="fa-solid fa-wine-glass"></i><span><b>Вкус:</b> ${x.v}</span></li>
   <li><i class="fa-solid fa-heart-pulse"></i><span><b>Эффект:</b> ${x.e}</span></li>
   <li><i class="fa-solid fa-temperature-half"></i><span><b>Заваривание:</b> ${x.c}</span></li>
  </ul>
 </article>`).join('');

/* Корзина */
let count=0;const cc=el('#cartCount');
document.addEventListener('click',e=>{
 const b=e.target.closest('.add');if(!b||b.classList.contains('done'))return;
 cc.textContent=++count;cc.classList.add('bump');setTimeout(()=>cc.classList.remove('bump'),300);
 const html=b.innerHTML;
 b.innerHTML='<i class="fa-solid fa-check"></i><span>Добавлено!</span>';
 b.classList.add('done');
 setTimeout(()=>{b.innerHTML=html;b.classList.remove('done')},1000);
});

/* Бургер */
const burger=el('#burger'),menu=el('#menu');
const toggle=o=>{burger.classList.toggle('active',o);menu.classList.toggle('open',o);burger.setAttribute('aria-expanded',o)};
burger.addEventListener('click',()=>toggle(!menu.classList.contains('open')));
menu.addEventListener('click',e=>{if(e.target.tagName==='A')toggle(false)});

/* Плавный скролл (запасной вариант к CSS) */
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
 const t=document.querySelector(a.getAttribute('href'));
 if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'})}
}));

/* Появление при скролле */
const io=new IntersectionObserver((entries,o)=>entries.forEach(en=>{
 if(en.isIntersecting){en.target.classList.add('visible');o.unobserve(en.target)}
}),{threshold:.12});
document.querySelectorAll('.reveal').forEach((n,i)=>{n.style.transitionDelay=(i%3)*0.08+'s';io.observe(n)});

/* Параллакс CTA */
const bg=el('#parallax'),cta=el('.cta');
addEventListener('scroll',()=>{
 const r=cta.getBoundingClientRect();
 if(r.bottom>0&&r.top<innerHeight)bg.style.transform=`translateY(${(r.top-innerHeight/2)*-0.15}px)`;
},{passive:true});
</script>
</body>
</html>
